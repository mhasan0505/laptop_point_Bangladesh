# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/
build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.test.example

# google credentials
google-credential.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local uploads
/public/uploads/*
!/public/uploads/.gitkeep

# runtime data stores (accessories.json is a seed so keep it tracked)
app/data/admin-users.json
app/data/media-meta.json
app/data/job-runs.json
app/data/questions.json

