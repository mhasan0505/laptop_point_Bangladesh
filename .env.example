# ─── Analytics integration (server-only) ─────────────────────────────────────
# Read ONLY in server contexts (route handlers / server components). Never
# exposed to the client bundle via NEXT_PUBLIC_* prefixes.

# Google Analytics / Search Console service account.
# Either point GOOGLE_APPLICATION_CREDENTIALS at a JSON file path (the SDK
# reads it natively) OR paste the JSON inline here / in GA_SERVICE_ACCOUNT.
GOOGLE_APPLICATION_CREDENTIALS=./path/to/service-account.json
# GOOGLE_APPLICATION_CREDENTIALS_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# GA4 property id (numeric) — already used by the rest of the storefront.
GA_PROPERTY_ID=123456789
# Alias if you prefer a descriptive name.
# GA4_PROPERTY_ID=

# Google Tag Manager Container ID
NEXT_PUBLIC_GTM_ID=GTM-KXKXGWF6

# GA4 Measurement ID (browser client tag)
NEXT_PUBLIC_GA_ID=G-NSPLFEW71H

# Google Search Console site URL (exactly as registered in GSC).
GSC_SITE_URL=sc-domain:laptoppointbd.com

# Meta Ads Marketing API.
META_ADS_ACCESS_TOKEN=EAAG...your-long-lived-token
META_ADS_ACCOUNT_ID=act_1234567890