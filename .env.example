# ==============================================================================
# LAPTOP POINT BD — APPLICATION ENVIRONMENT CONFIGURATION
# ==============================================================================
# This file documents EVERY environment variable consumed by the application.
# Copy this file to `.env.local` for local development.
# In Vercel / Production, configure these under Project Settings -> Environment Variables.
#
# Rules:
# - Variables prefixed with `NEXT_PUBLIC_` are bundled into browser JavaScript.
#   NEVER put private keys, passwords, or connection strings in NEXT_PUBLIC_ variables.
# - All server-only secrets must remain non-prefixed.
# ==============================================================================

# ==============================================================================
# 1. DATABASE & CACHING (PostgreSQL / Neon)
# ==============================================================================

# Database Connection URL (PostgreSQL)
# Required in: Dev (optional with mock), Staging (Required), Production (Required)
# Where to obtain: Neon Console (https://console.neon.tech) -> Connection Details (pooled mode recommended: pgbouncer)
DATABASE_URL="postgresql://user:password@ep-wild-fog-123456-pooler.us-east-2.aws.neon.tech/laptoppoint_bangladesh?sslmode=require&pgbouncer=true"

# Cross-Instance Data Cache TTL (in milliseconds)
# Default: 15000 (15 seconds). Set to 0 to disable in-memory caching and fetch fresh from DB every time.
# Required in: Optional (all environments)
DATA_CACHE_TTL_MS=15000

# ==============================================================================
# 2. CORE SECURITY & ADMIN AUTHENTICATION
# ==============================================================================

# Primary Store Owner Email (Break-glass initial access)
# Required in: Staging (Required), Production (Required), Dev (Defaults to admin@laptoppointbd.com)
# Where to obtain: Determined by business owner
ADMIN_EMAIL="admin@laptoppointbd.com"

# Primary Store Owner Password
# Required in: Staging (Required), Production (Required), Dev (Required)
# Must be a strong password of at least 8 characters with letters, numbers, and symbols.
ADMIN_PASSWORD="ReplaceWithSuperSecureAdminPassword123!"

# Admin HMAC Session Signing Secret
# Required in: Dev (Required), Staging (Required), Production (Required)
# Must be a cryptographically random string of at least 32 characters.
# Where to obtain: Generate via `openssl rand -hex 32` or `node -e "console.log(crypto.randomBytes(32).toString('hex'))"`
ADMIN_SESSION_SECRET="replace-with-at-least-32-chars-hex-string-for-session-signing-secret"

# Settings & Credentials AES-256-GCM Encryption Key
# Required in: Staging (Required), Production (Required), Dev (Optional fallback in dev)
# Must be exactly 64 hexadecimal characters (32 bytes).
# Where to obtain: Generate via `openssl rand -hex 32`
SETTINGS_ENCRYPTION_KEY="replace_with_64_character_hex_key_for_aes_256_gcm_encryption_0000000"

# Rate Limiting Storage Engine
# Options: "memory" (default for single-instance/dev) or "redis"
# Required in: Optional (Defaults to "memory")
RATE_LIMIT_STORE=memory

# Trusted Reverse Proxy Mode
# Options: "vercel", "cloudflare", "xff", or unset (direct)
# Required in: Production (Set to "vercel" on Vercel deployment)
TRUSTED_PROXY=vercel

# Staging Database Host Allow-list (for test runners and staging verification scripts)
# Required in: Test / Staging only. Write-capable scripts refuse execution unless target host matches.
# Where to obtain: Hostname of your staging PostgreSQL (e.g., localhost or ep-staging.neon.tech)
# STAGING_DB_HOST="localhost"
# STAGING_DB_FINGERPRINT="2bb80e5e7cd6032529094396416347560c1e729d6b85d68a9014d86393a229e6"

# ==============================================================================
# 3. ASSET STORAGE & IMAGE OPTIMIZATION (ImageKit CDN)
# ==============================================================================

# ImageKit Public Key
# Required in: Production (Required), Staging (Required), Dev (Optional if mock used)
# Where to obtain: ImageKit Dashboard (https://imagekit.io/dashboard/developer/api-keys)
IMAGEKIT_PUBLIC_KEY="public_replace_with_your_imagekit_public_key="

# ImageKit Private Key (SERVER-ONLY — NEVER EXPOSE TO CLIENT)
# Required in: Production (Required), Staging (Required), Dev (Optional)
# Where to obtain: ImageKit Dashboard -> API Keys
IMAGEKIT_PRIVATE_KEY="private_replace_with_your_imagekit_private_key="

# ImageKit URL Endpoint
# Required in: Production (Required), Staging (Required), Dev (Optional)
# Where to obtain: ImageKit Dashboard -> URL-endpoints
IMAGEKIT_URL_ENDPOINT="https://ik.imagekit.io/laptoppoint"

# Maximum Client-Side Upload Size (in Megabytes)
# Default: 16 (16 MB limit enforced before client compression and server ingestion)
# Required in: Optional (Client-safe)
NEXT_PUBLIC_MAX_UPLOAD_MB=16

# Allow Local File Uploads Fallback
# Set to "1" in development if you do not want to upload to ImageKit.
# Forbidden in production (serverless filesystem is read-only).
ALLOW_LOCAL_UPLOADS=0

# ==============================================================================
# 4. STOREFRONT ANALYTICS & CONVERSION TRACKING
# ==============================================================================

# Google Tag Manager Container ID (Client-safe)
# Required in: Production (Required), Dev/Staging (Optional)
# Where to obtain: Google Tag Manager (https://tagmanager.google.com)
NEXT_PUBLIC_GTM_ID="GTM-KXKXGWF6"

# Google Analytics 4 Measurement ID (Client-safe)
# Required in: Production (Required), Dev/Staging (Optional)
# Where to obtain: Google Analytics -> Admin -> Data Streams -> Measurement ID
NEXT_PUBLIC_GA_ID="G-NSPLFEW71H"

# Meta (Facebook) Pixel ID (Client-safe)
# Required in: Production (Required), Dev/Staging (Optional)
# Where to obtain: Meta Events Manager -> Data Sources
NEXT_PUBLIC_FB_PIXEL_ID="1676617903511293"

# Bing Webmaster Tools Site Verification Code (Client-safe)
# Required in: Optional (SEO verification meta tag in app/layout.tsx)
# Where to obtain: Bing Webmaster Tools -> Add site -> Verification
NEXT_PUBLIC_BING_SITE_VERIFICATION=""

# GA4 Numeric Property ID (Server-only for admin analytics dashboard)
# Required in: Optional (Admin dashboard analytics card)
# Where to obtain: Google Analytics -> Admin -> Property Settings -> Property ID
GA_PROPERTY_ID="123456789"
# GA4_PROPERTY_ID="123456789"

# Google Search Console Site URL (Server-only)
# Required in: Optional (Admin dashboard SEO cards)
# Where to obtain: Google Search Console property identifier (e.g. sc-domain:laptoppointbd.com)
GSC_SITE_URL="sc-domain:laptoppointbd.com"

# Google Cloud Service Account Credentials (Server-only)
# Either file path OR raw JSON string with read access to GA4 and Search Console APIs.
# On Vercel / serverless (read-only filesystem), set GOOGLE_APPLICATION_CREDENTIALS_JSON or GA_SERVICE_ACCOUNT as string.
# Where to obtain: Google Cloud Console -> IAM & Admin -> Service Accounts -> Create Key (JSON)
# GOOGLE_APPLICATION_CREDENTIALS="./service-account.json"
# GOOGLE_APPLICATION_CREDENTIALS_JSON='{"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}'
# GA_SERVICE_ACCOUNT='{"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}'
# GSC_SERVICE_ACCOUNT='{"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}'

# Meta Marketing API (Server-only)
# Required in: Optional (Admin dashboard ads performance card)
# Where to obtain: Meta Business Manager -> System Users -> Generate Token (ads_read)
META_ADS_ACCESS_TOKEN="EAAG...your-long-lived-token"
META_ADS_ACCOUNT_ID="act_1234567890"

# ==============================================================================
# 5. COURIER & LOGISTICS (Steadfast Courier API)
# ==============================================================================

# Steadfast Courier API Key (Server-only)
# Required in: Optional (when automatic delivery dispatch is enabled)
# Where to obtain: Steadfast Merchant Dashboard (https://steadfast.com.bd) -> Settings -> API
STEADFAST_API_KEY=""

# Steadfast Courier Secret Key (Server-only)
# Required in: Optional (when automatic delivery dispatch is enabled)
# Where to obtain: Steadfast Merchant Dashboard -> Settings -> API
STEADFAST_SECRET_KEY=""

# ==============================================================================
# 6. PAYMENT GATEWAYS (bKash Checkout)
# ==============================================================================

# bKash Merchant Credentials (Server-only)
# Required in: Optional (when direct bKash online checkout is enabled)
# Where to obtain: bKash Merchant Portal / Developer agreement
BKASH_APP_KEY=""
BKASH_APP_SECRET=""
BKASH_USERNAME=""
BKASH_PASSWORD=""

# ==============================================================================
# 7. SOCIAL OAUTH (Optional Customer Login)
# ==============================================================================

# Google OAuth Credentials (Server-only)
# Where to obtain: Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Alternative alias names accepted by lib/auth-providers.ts:
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# Facebook OAuth Credentials (Server-only)
# Where to obtain: Meta for Developers -> App -> Facebook Login -> Settings
AUTH_FACEBOOK_ID=""
AUTH_FACEBOOK_SECRET=""
# Alternative alias names accepted by lib/auth-providers.ts:
# FACEBOOK_CLIENT_ID=""
# FACEBOOK_CLIENT_SECRET=""

# ==============================================================================
# 8. CRON & BACKGROUND JOBS
# ==============================================================================

# Vercel Cron Secret (Server-only)
# Required in: Production (Enforced by fail-fast startup validator in lib/env.ts).
# Note: Vercel Cron automatically passes this secret in the Authorization header as `Bearer <CRON_SECRET>`.
# Format: Bearer token passed in the Authorization header (`Bearer <CRON_SECRET>`).
CRON_SECRET="replace-with-a-random-32-byte-hex-token-for-cron-invocations"

# ==============================================================================
# 9. DEPRECATED / UNUSED SECRETS
# ==============================================================================

# JWT_SECRET (DEPRECATED)
# NOT USED. The application uses state-of-the-art HMAC SHA-256 session cookies signed
# with `ADMIN_SESSION_SECRET` via lib/admin-auth.ts. Do not set or use JWT_SECRET.
# JWT_SECRET=""

# ==============================================================================
# 10. FEATURE FLAGS
# ==============================================================================

# Enable Product Variants (Client-safe)
# Default: unset / "false" for initial delivery. Keep unset unless multi-variant products are explicitly enabled.
# NEXT_PUBLIC_ENABLE_VARIANTS="false"