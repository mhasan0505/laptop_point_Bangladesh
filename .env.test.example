# ─── Staging / Test Environment Configuration ────────────────────────────────
# To prevent accidental data alteration, any test script that performs writes
# (e.g. creating/deleting products, updating settings, creating test orders)
# strictly requires DATABASE_URL to match the STAGING_DB_HOST allow-list.
#
# If STAGING_DB_HOST does not match the host in DATABASE_URL, the write scripts
# will immediately abort with a safety refusal.

# Hostname of the staging or local Postgres database (e.g. localhost or staging-branch.neon.tech)
STAGING_DB_HOST=localhost

# Staging PostgreSQL connection string (NEVER point this to the development or production database)
DATABASE_URL="postgresql://postgres:password@localhost:5432/laptoppoint_staging?schema=public"

# Test server base URL
TEST_URL="http://localhost:3000"

# Admin credentials for test runner
ADMIN_EMAIL="admin@laptoppointbd.com"
ADMIN_PASSWORD="TestPassword123!Safe"
ADMIN_SESSION_SECRET="test-session-secret-must-be-at-least-32-chars-long"

# ImageKit test credentials (optional / mock)
IMAGEKIT_PUBLIC_KEY="test_public_key"
IMAGEKIT_PRIVATE_KEY="test_private_key"
IMAGEKIT_URL_ENDPOINT="https://ik.imagekit.io/test"

# Allow writes flag for test runners that require explicit opt-in
TEST_ALLOW_WRITE=1
