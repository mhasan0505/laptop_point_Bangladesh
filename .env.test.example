# ─── Staging / Test Environment Configuration ────────────────────────────────
# To prevent accidental data alteration, any test script that performs writes
# (e.g. creating/deleting products, updating settings, creating test orders)
# strictly requires the server & local DATABASE_URL host fingerprint to match the
# STAGING_DB_FINGERPRINT or STAGING_DB_HOST allow-list.
#
# If the fingerprint does not match, all write-capable scripts immediately abort.

# ==============================================================================
# OPTION A: Local Docker PostgreSQL (Port 55432)
# ==============================================================================
# Start local staging database:
#   pnpm staging:up
# Stop local staging database:
#   pnpm staging:down
#
# Deploy Prisma migrations to staging:
#   npx prisma migrate deploy
#
# Allow-list configuration for local Docker:
STAGING_DB_HOST=localhost
DATABASE_URL="postgresql://laptoppoint_staging:staging_secret_password_123@localhost:55432/laptoppoint_staging_db?sslmode=disable"

# SHA-256 fingerprint of "localhost":
# 2bb80e5e7cd6032529094396416347560c1e729d6b85d68a9014d86393a229e6
# STAGING_DB_FINGERPRINT="2bb80e5e7cd6032529094396416347560c1e729d6b85d68a9014d86393a229e6"

# ==============================================================================
# OPTION B: Neon Cloud Staging Branch (Recommended if Docker is unavailable)
# ==============================================================================
# 1. In Neon Console (https://console.neon.tech), create a branch named "staging"
#    or use the Neon CLI:
#      neon branches create --name staging
# 2. Copy the connection string for the "staging" branch:
#      DATABASE_URL="postgresql://<user>:<pass>@ep-staging-branch-123456.<region>.aws.neon.tech/laptoppoint_db?sslmode=require"
# 3. Set the staging hostname below:
#      STAGING_DB_HOST="ep-staging-branch-123456.<region>.aws.neon.tech"
# 4. Deploy schema migrations:
#      npx prisma migrate deploy

# ==============================================================================
# Test Server & Credentials
# ==============================================================================
# Test server base URL
TEST_URL="http://localhost:3000"

# Admin credentials for test runner
ADMIN_EMAIL="admin@laptoppointbd.com"
ADMIN_PASSWORD="TestPassword123!Safe"
ADMIN_SESSION_SECRET="test-session-secret-must-be-at-least-32-chars-long"

# ImageKit test credentials (optional / mock)
IMAGEKIT_PUBLIC_KEY="test_public_key"
IMAGEKIT_PRIVATE_KEY="test_private_key"
IMAGEKIT_URL_ENDPOINT="https://ik.imagekit.io/test"

# In-memory data cache TTL in milliseconds (default 15000, 0 = disabled)
DATA_CACHE_TTL_MS=15000

# Allow writes flag for test runners that require explicit opt-in
TEST_ALLOW_WRITE=1

