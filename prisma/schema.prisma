generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────

enum PaymentMethod {
  COD
  BKASH
  NAGAD
  CARD
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum UnitStatus {
  IN_STOCK
  RESERVED
  SOLD
  RMA
}

// ─────────────────────────────────────────────────────────────
// ORDERS
// ─────────────────────────────────────────────────────────────

model Order {
  id            String   @id @default(cuid())
  orderNumber   String   @unique

  // Customer snapshot
  customerName  String
  customerPhone String
  customerEmail String?

  // Shipping address snapshot
  address       String?
  city          String?
  district      String?
  postalCode    String?

  // Financials (in BDT) - Changed to Decimal for precise financial arithmetic
  subtotal      Decimal  @db.Decimal(10, 2)
  shippingCost  Decimal  @default(100.00) @db.Decimal(10, 2)
  totalAmount   Decimal  @db.Decimal(10, 2)

  paymentMethod PaymentMethod @default(COD)
  paymentStatus PaymentStatus @default(PENDING)
  status        OrderStatus   @default(PENDING)
  
  notes         String?
  trackingNumber String?
  deliveredAt   DateTime?

  items         OrderItem[]
  statusHistory OrderStatusEvent[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([customerPhone])
  @@index([customerName])
}

model OrderItem {
  id                String   @id @default(cuid())
  orderId           String
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // External reference (Sanity)
  productId         String
  sku               String
  name              String
  unitPrice         Decimal  @db.Decimal(10, 2)
  quantity          Int

  inventoryDeducted Boolean  @default(false)
  
  // Link to the specific physical units shipped
  units             InventoryUnit[]

  @@index([orderId])
  @@index([productId])
}

model OrderStatusEvent {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())

  @@index([orderId])
}

// ─────────────────────────────────────────────────────────────
// INVENTORY & ERP
// ─────────────────────────────────────────────────────────────

// High-level aggregate stock (Calculated or cached)
model Inventory {
  id        String   @id @default(cuid())
  productId String   @unique 
  sku       String   @unique
  name      String

  quantity  Int      @default(0) 
  reserved  Int      @default(0) 

  updatedAt DateTime @updatedAt

  @@index([quantity])
}

// Physical units (Essential for Laptops / Serial Number Tracking & Cash Flow)
model InventoryUnit {
  id           String     @id @default(cuid())
  productId    String     // Links to Sanity Product
  sku          String
  serialNumber String     @unique
  
  status       UnitStatus @default(IN_STOCK)
  costPrice    Decimal    @db.Decimal(10, 2) // Wholesale cost for profit calculation
  
  orderItemId  String?
  orderItem    OrderItem? @relation(fields: [orderItemId], references: [id])

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([productId, status])
  @@index([orderItemId])
}

model InventoryLog {
  id        String   @id @default(cuid())
  productId String
  sku       String

  delta     Int 
  reason    String 
  orderId   String? 
  note      String?

  createdAt DateTime @default(now())

  @@index([productId])
  @@index([createdAt])
}